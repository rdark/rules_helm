# git ignore patterns

# Bazel
/bazel-*
user.bazelrc

# Building a module in `modules/` as its own root writes these there.
/modules/*/bazel-*
/modules/*/MODULE.bazel.lock

# Helm
# Dependency charts are not checked in and are instead handled by Bazel.
**/charts/**
# Lock files are not used by Bazel. Instead, lock information is required by repository rules
Chart.lock
.idea/
